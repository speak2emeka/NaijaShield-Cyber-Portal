generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  STAFF
  ANALYST
  ADMIN
  SUPERADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ServiceRequestStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceRequestType {
  PENTEST
  INCIDENT_RESPONSE
  SECURITY_ASSESSMENT
  CLOUD_SECURITY_AUDIT
  COMPLIANCE_REVIEW
  TRAINING
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  role            UserRole         @default(CLIENT)
  name            String
  clientCompanyId String?
  clientCompany   ClientCompany?   @relation(fields: [clientCompanyId], references: [id])
  refreshTokens   RefreshToken[]
  tickets         Ticket[]         @relation("TicketCreator")
  auditLogs       AuditLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ClientCompany {
  id                   String                 @id @default(uuid())
  name                 String
  industry             String
  size                 String
  contactEmail         String
  users                User[]
  reports              Report[]
  tickets              Ticket[]
  serviceRequests      ServiceRequest[]
  securityScoreHistory SecurityScoreHistory[]
  subscription         Subscription?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model Ticket {
  id               String          @id @default(uuid())
  clientCompanyId  String
  createdByUserId  String
  title            String
  description      String
  status           TicketStatus    @default(OPEN)
  priority         TicketPriority  @default(MEDIUM)
  internalNotes    String?
  clientCompany    ClientCompany   @relation(fields: [clientCompanyId], references: [id])
  createdBy        User            @relation("TicketCreator", fields: [createdByUserId], references: [id])
  comments         TicketComment[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  body      String
  internal  Boolean  @default(false)
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  createdAt DateTime @default(now())
}

model ServiceRequest {
  id              String               @id @default(uuid())
  clientCompanyId String
  type            ServiceRequestType
  description     String
  status          ServiceRequestStatus @default(PENDING)
  clientCompany   ClientCompany        @relation(fields: [clientCompanyId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Report {
  id              String        @id @default(uuid())
  clientCompanyId String
  title           String
  description     String
  filePath        String
  clientCompany   ClientCompany @relation(fields: [clientCompanyId], references: [id])
  createdAt       DateTime      @default(now())
}

model SecurityScoreHistory {
  id              String        @id @default(uuid())
  clientCompanyId String
  score           Int
  calculatedAt    DateTime      @default(now())
  notes           String?
  clientCompany   ClientCompany @relation(fields: [clientCompanyId], references: [id])
}

model Subscription {
  id              String             @id @default(uuid())
  clientCompanyId String             @unique
  plan            String
  status          SubscriptionStatus @default(TRIAL)
  startDate       DateTime
  endDate         DateTime?
  renewalDate     DateTime?
  paymentHistory  Json?
  clientCompany   ClientCompany      @relation(fields: [clientCompanyId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  revokedAt  DateTime?
  expiresAt  DateTime
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}
