generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  STAFF
  ANALYST
  SUPERVISOR
  AUDITOR
  ADMIN
  SUPERADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ServiceRequestStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceRequestType {
  PENTEST
  INCIDENT_RESPONSE
  SECURITY_ASSESSMENT
  CLOUD_SECURITY_AUDIT
  COMPLIANCE_REVIEW
  TRAINING
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum NotificationType {
  INFO
  WARNING
  ALERT
  REPORT
  TICKET
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum BillingProvider {
  PAYSTACK
  STRIPE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  FAILED
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetType {
  DOMAIN
  IP
  APP
  CLOUD
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplianceFramework {
  ISO27001
  SOC2
  NDPR
}

enum ComplianceItemStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum AttackDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AttackPhase {
  RECON
  INITIAL_ACCESS
  LATERAL_MOVEMENT
  EXFILTRATION
  CONTAINMENT
  RECOVERY
}

enum AiArtifactType {
  THREAT_MODEL
  ATTACK_SURFACE
  TEST_CASES
  VULN_ANALYSIS
  REPORT
}

enum ScanTool {
  ZAP
  NMAP
  SEMGREP
  DEPENDENCY
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum EvidenceType {
  SCREENSHOT
  LOG
  NOTE
  REQUEST
  RESPONSE
  OTHER
}

enum StaffScope {
  ADMIN
  CLIENT
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  role            UserRole         @default(CLIENT)
  name            String
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean          @default(false)
  mfaSecret       String?
  clientCompanyId String?
  clientCompany   ClientCompany?   @relation(fields: [clientCompanyId], references: [id])
  refreshTokens   RefreshToken[]
  tickets         Ticket[]         @relation("TicketCreator")
  ticketComments  TicketComment[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  authTokens      AuthToken[]
  sessions        UserSession[]
  backupCodes     BackupCode[]
  evidenceItems   EvidenceItem[]
  staffAssignments StaffAssignment[]
  aiArtifacts     AiArtifact[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([role])
  @@index([clientCompanyId])
  @@index([deletedAt])
}

model ClientCompany {
  id                   String                 @id @default(uuid())
  name                 String
  industry             String
  size                 String
  contactEmail         String
  tenantKeyId          String?
  keyRotationDueAt     DateTime?
  users                User[]
  reports              Report[]
  tickets              Ticket[]
  serviceRequests      ServiceRequest[]
  securityScoreHistory SecurityScoreHistory[]
  securityPosture      SecurityPostureSummary?
  securityEvents       SecurityEvent[]
  assets               ClientAsset[]
  complianceStatuses   ComplianceStatus[]
  attackRuns           AttackRun[]
  subscription         Subscription?
  notifications        Notification[]
  aiArtifacts          AiArtifact[]
  scanRuns             SecurityScanRun[]
  ciResults            CiSecurityResult[]
  evidenceItems        EvidenceItem[]
  staffAssignments     StaffAssignment[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?

  @@index([industry])
  @@index([tenantKeyId])
  @@index([deletedAt])
}

model Ticket {
  id               String          @id @default(uuid())
  clientCompanyId  String
  createdByUserId  String
  title            String
  description      String
  status           TicketStatus    @default(OPEN)
  priority         TicketPriority  @default(MEDIUM)
  internalNotes    String?
  clientCompany    ClientCompany   @relation(fields: [clientCompanyId], references: [id])
  createdBy        User            @relation("TicketCreator", fields: [createdByUserId], references: [id])
  comments         TicketComment[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  @@index([clientCompanyId, status])
  @@index([createdByUserId])
  @@index([priority])
  @@index([updatedAt])
  @@index([deletedAt])
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  body      String
  internal  Boolean  @default(false)
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
}

model ServiceRequest {
  id              String               @id @default(uuid())
  clientCompanyId String
  type            ServiceRequestType
  description     String
  status          ServiceRequestStatus @default(PENDING)
  clientCompany   ClientCompany        @relation(fields: [clientCompanyId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  @@index([clientCompanyId, status])
  @@index([type])
  @@index([updatedAt])
  @@index([deletedAt])
}

model Report {
  id              String        @id @default(uuid())
  clientCompanyId String
  title           String
  description     String
  filePath        String
  fileUrl         String?
  storageKey      String?
  checksum        String?
  mimeType        String?
  sizeBytes       Int?
  clientCompany   ClientCompany @relation(fields: [clientCompanyId], references: [id])
  createdAt       DateTime      @default(now())
  deletedAt       DateTime?

  @@index([clientCompanyId, createdAt])
  @@index([deletedAt])
}

model SecurityScoreHistory {
  id              String        @id @default(uuid())
  clientCompanyId String
  score           Int
  calculatedAt    DateTime      @default(now())
  notes           String?
  clientCompany   ClientCompany @relation(fields: [clientCompanyId], references: [id])

  @@index([clientCompanyId, calculatedAt])
}

model Subscription {
  id                     String             @id @default(uuid())
  clientCompanyId        String             @unique
  plan                   String
  status                 SubscriptionStatus @default(TRIAL)
  provider               BillingProvider?
  providerCustomerId     String?
  providerSubscriptionId String?
  startDate              DateTime
  endDate                DateTime?
  renewalDate            DateTime?
  trialEndsAt            DateTime?
  graceEndsAt            DateTime?
  billingInterval        String             @default("monthly")
  featureFlags           Json?
  metadata               Json?
  paymentHistory         Json?
  clientCompany          ClientCompany      @relation(fields: [clientCompanyId], references: [id])
  invoices               Invoice[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status])
  @@index([provider])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  revokedAt  DateTime?
  expiresAt  DateTime
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  action        String
  entityType    String
  entityId      String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  user          User?    @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@index([correlationId])
}

model Notification {
  id              String           @id @default(uuid())
  userId          String?
  clientCompanyId String?
  type            NotificationType @default(INFO)
  message         String
  read            Boolean          @default(false)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientCompany   ClientCompany?   @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())

  @@index([userId, read])
  @@index([clientCompanyId, read])
  @@index([createdAt])
}

model KnowledgeBaseArticle {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([deletedAt])
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model UserSession {
  id          String    @id @default(uuid())
  userId      String
  userAgent   String?
  ipAddress   String?
  deviceLabel String?
  deviceFingerprint String?
  country     String?
  riskScore   Int       @default(0)
  riskFlags   Json?
  stepUpRequired Boolean @default(false)
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([riskScore])
}

model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model Invoice {
  id                String          @id @default(uuid())
  subscriptionId    String
  provider          BillingProvider
  providerInvoiceId String?
  amount            Int
  currency          String          @default("NGN")
  status            InvoiceStatus   @default(OPEN)
  hostedUrl         String?
  paidAt            DateTime?
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model SecurityEvent {
  id              String           @id @default(uuid())
  clientCompanyId String?
  type            String
  severity        SecuritySeverity @default(LOW)
  source          String
  message         String
  metadata        Json?
  correlationId   String?
  clientCompany   ClientCompany?   @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())

  @@index([clientCompanyId, createdAt])
  @@index([type])
  @@index([severity])
  @@index([source])
}

model SecurityPostureSummary {
  id               String        @id @default(uuid())
  clientCompanyId  String        @unique
  score            Int
  lastCalculatedAt DateTime      @default(now())
  breakdown        Json
  clientCompany    ClientCompany @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)

  @@index([score])
  @@index([lastCalculatedAt])
}

model ClientAsset {
  id              String        @id @default(uuid())
  clientCompanyId String
  type            AssetType
  identifier      String
  riskLevel       RiskLevel     @default(LOW)
  lastSeenAt      DateTime      @default(now())
  metadata        Json?
  clientCompany   ClientCompany @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)

  @@index([clientCompanyId, riskLevel])
  @@index([type])
  @@unique([clientCompanyId, identifier])
}

model ComplianceStatus {
  id              String                 @id @default(uuid())
  clientCompanyId String
  framework       ComplianceFramework
  status          ComplianceItemStatus   @default(NOT_STARTED)
  score           Int                    @default(0)
  checklist       Json
  lastUpdatedAt   DateTime               @updatedAt
  evidence        ComplianceEvidence[]
  clientCompany   ClientCompany          @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)

  @@unique([clientCompanyId, framework])
  @@index([framework, status])
}

model ComplianceEvidence {
  id                 String           @id @default(uuid())
  complianceStatusId String
  title              String
  reportId           String?
  fileUrl            String?
  createdAt          DateTime         @default(now())
  complianceStatus   ComplianceStatus @relation(fields: [complianceStatusId], references: [id], onDelete: Cascade)

  @@index([complianceStatusId])
}

model AttackScenario {
  id          String           @id @default(uuid())
  title       String
  description String
  category    String
  difficulty  AttackDifficulty @default(BEGINNER)
  safetyNote  String
  eventTemplate Json
  attackerTemplate Json
  defenderTemplate Json
  runs        AttackRun[]
  createdAt   DateTime         @default(now())

  @@index([category])
  @@index([difficulty])
}

model AttackRun {
  id              String        @id @default(uuid())
  scenarioId      String
  clientCompanyId String
  startedAt       DateTime      @default(now())
  finishedAt      DateTime?
  resultSummary   Json?
  attackerView    Json?
  defenderView    Json?
  scenario        AttackScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  clientCompany   ClientCompany   @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  events          AttackEvent[]

  @@index([clientCompanyId, startedAt])
  @@index([scenarioId])
}

model AttackEvent {
  id          String           @id @default(uuid())
  attackRunId String
  timestamp   DateTime         @default(now())
  phase       AttackPhase
  description String
  severity    SecuritySeverity @default(LOW)
  metadata    Json?
  attackRun   AttackRun        @relation(fields: [attackRunId], references: [id], onDelete: Cascade)

  @@index([attackRunId, timestamp])
  @@index([phase])
  @@index([severity])
}

model AiArtifact {
  id              String         @id @default(uuid())
  clientCompanyId String?
  type            AiArtifactType
  title           String
  input           Json
  output          Json
  createdByUserId String?
  clientCompany   ClientCompany? @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  createdBy       User?          @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([clientCompanyId, type, createdAt])
  @@index([createdByUserId])
}

model SecurityScanRun {
  id              String        @id @default(uuid())
  clientCompanyId String?
  tool            ScanTool
  target          String
  status          ScanStatus    @default(QUEUED)
  scheduledFor    DateTime?
  startedAt       DateTime      @default(now())
  finishedAt      DateTime?
  summary         Json?
  rawResult       Json?
  clientCompany   ClientCompany? @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([clientCompanyId, createdAt])
  @@index([tool, status])
}

model CiSecurityResult {
  id              String        @id @default(uuid())
  clientCompanyId String?
  repository      String
  branch          String
  commitSha       String?
  pipelineId      String?
  score           Int
  status          String
  findings        Json
  summary         Json
  clientCompany   ClientCompany? @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([clientCompanyId, createdAt])
  @@index([repository, branch])
}

model EvidenceItem {
  id              String        @id @default(uuid())
  clientCompanyId String?
  uploadedByUserId String?
  type            EvidenceType  @default(OTHER)
  title           String
  description     String?
  tags            String[]
  findingRef      String?
  fileUrl         String?
  storageKey      String?
  summary         Json?
  clientCompany   ClientCompany? @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  uploadedBy      User?          @relation(fields: [uploadedByUserId], references: [id])
  createdAt       DateTime      @default(now())

  @@index([clientCompanyId, createdAt])
  @@index([uploadedByUserId])
}

model StaffAssignment {
  id              String        @id @default(uuid())
  userId          String
  clientCompanyId String?
  scope           StaffScope
  role            UserRole
  permissions     String[]
  active          Boolean       @default(true)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientCompany   ClientCompany? @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([scope, role, active])
  @@index([clientCompanyId])
  @@unique([userId, clientCompanyId, scope])
}
